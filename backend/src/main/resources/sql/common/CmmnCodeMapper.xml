<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cookmate.cookmate_web.domain.common.mapper.CmmnCodeMapper">

    <select id="selectCmmnCodeList"
            parameterType="com.cookmate.cookmate_web.domain.common.dto.CmmnCodeDTO$Request"
            resultType="com.cookmate.cookmate_web.domain.common.dto.CmmnCodeDTO$Response">
        /* CmmnCodeMapper.selectCmmnCodeList : 공통코드 상세 목록 조회 */
        SELECT CD
             , GRP_CD
             , CD_NM
             , SORT_ORD
        FROM CMMN_DETAIL_CD
        WHERE GRP_CD = #{grpCd}
          AND USE_YN = 'Y'
          AND DEL_YN = 'N'
        ORDER BY SORT_ORD
    </select>

</mapper>
